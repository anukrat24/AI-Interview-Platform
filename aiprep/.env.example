# Copy this file to .env for local development and fill in real values.
# NEVER commit the real .env file, and never commit real secrets to git.

# ---- Database ----
DB_URL=jdbc:postgresql://localhost:5432/ai_interview
DB_USERNAME=postgres
DB_PASSWORD=change-me
DDL_AUTO=update

# ---- Mail (OTP + notifications) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
# Use a Gmail "App Password", not your real Gmail password
MAIL_PASSWORD=your-app-password

# ---- JWT ----
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION_MS=3600000

# ---- OpenAI ----
GEMINI_API_KEY=

# ---- Google OAuth2 login (optional - only needed if you enable the "oauth" profile) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Code execution sandbox (Piston public API - no key needed, override only if self-hosting) ----
PISTON_BASE_URL=https://emkc.org/api/v2/piston

# ---- Razorpay (payments/subscriptions) ----
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_PREMIUM_AMOUNT_PAISE=49900

# ---- Free tier limits ----
FREE_INTERVIEWS_PER_DAY=3

# ---- Server ----
PORT=8080

# ---- Cookies ----
# true in production (Render/Railway/Fly.io all serve HTTPS by default).
# Set to false ONLY if you are testing locally over plain http://localhost.
COOKIE_SECURE=true
